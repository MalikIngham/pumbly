# Copy to backend/.env. This is the CONSUMER_KEY from the old localflaskapp.cfg.
TUMBLR_CONSUMER_KEY=

# The secret key from the same Tumblr app. Lets you connect your account, which
# is what makes login-only blogs visible.
TUMBLR_CONSUMER_SECRET=

# Comma separated origins of the frontend
ALLOWED_ORIGINS=http://localhost:3000
